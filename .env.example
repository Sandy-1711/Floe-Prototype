# ── Floe path (default) ─────────────────────────────────────────────
# One key drives LLM + search + STT + TTS. https://floelabs.xyz
FLOE_API_KEY=
# Floe uses OpenAI-style, provider-prefixed model ids.
FLOE_MODEL=google/gemini-2.5-flash

# ── Direct-to-vendor fallback (only used if FLOE_API_KEY is unset) ───
# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Direct Gemini wants the bare model id (no provider prefix).
GEMINI_MODEL=gemini-2.5-flash

# Exa search — https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Sarvam AI (STT + TTS) — https://dashboard.sarvam.ai
SARVAM_API_KEY=

# ── Server ──────────────────────────────────────────────────────────
PORT=4111
WEB_ORIGIN=http://localhost:3000
